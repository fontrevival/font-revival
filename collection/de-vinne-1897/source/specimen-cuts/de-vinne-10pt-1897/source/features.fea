languagesystem DFLT dflt;
languagesystem latn dflt;
feature ss01 {
    featureNames { name "Census M"; };
    sub M by M.census;
} ss01;
feature ss02 {
    featureNames { name "1897 figure variants (1, 3, 4, 5)"; };
    sub one by one.oldstyle;
    sub three by three.oldstyle;
    sub four by four.oldstyle;
    sub five by five.oldstyle;
} ss02;
feature ss03 {
    featureNames { name "Lining figure variants (0, 7)"; };
    sub zero by zero.lining;
    sub seven by seven.lining;
} ss03;
feature ss04 {
    featureNames { name "Broad S"; };
    sub S by S.broad;
} ss04;
