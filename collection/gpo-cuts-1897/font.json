  "postscript_name": "GPOCuts1897-Regular",
  "year": 1897,
  "designer": "Historical engravers unidentified except for signatures retained in the impressions",
  "foundry": "U.S. Government Printing Office; original cut suppliers not specified",
  "description": "Distinct historical seals and emblems from the Government Printing Office specimen of 1897.",
  "license": "MIT OR OFL-1.1",
  "copyright": "Copyright (c) 2026 Harold Lehmann",
  "sample_text": "",
  "observed": "Fourteen complete compositions from the 1897 seal pages. The inventory also records twenty-two witnesses of existing GPO designs and one repeated Agriculture seal.",
  "reconstructed": "No new pictorial content. Native crops, measured caption and paper-speck removal, curve fitting and uniform scaling interpret the historical impressions. Three tonal regions interpret scanned ink strength. Names, tags, Private Use assignments, bearings and a blank space are new project work.",
  "revival": {
    "author": "Harold Lehmann",
    "tools": [
      "Pillow 12.3.0",
      "Potrace 1.16",
      "fontTools 4.64.0",
      "skia-pathops 0.9.0",
      "NumPy 1.26.4 (optional exact mask preparation)",
      "SciPy 1.11.4 (optional exact mask preparation)"
    ],
    "notes": "Complete compositions include integral inscriptions. Different size or ink weight alone does not establish a new design. Matching earlier witnesses improve the existing GPO1904 identities where clearer."
  },
  "cff_charstring_chunk_bytes": 60000,
