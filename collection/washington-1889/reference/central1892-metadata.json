989","word_conf_51_60":"542","word_conf_61_70":"278","word_conf_71_80":"164","word_conf_81_90":"71","word_conf_91_100":"235","format":"OCR Search Text","original":"central-boston-1892-hathi-mdp-39015063770823-png_hocr.html","mtime":"1767211210","size":"49478","md5":"e0c8c94c802450ca33a5696df4567b6a","crc32":"0e6bccb4","sha1":"fb3062cbbf19747de8fea76a8e24581d2b3d82d2"},{"name":"central-boston-1892-hathi-mdp-39015063770823-png_jp2.zip","source":"derivative","format":"Single Page Processed JP2 ZIP","original":"central-boston-1892-hathi-mdp-39015063770823-png.pdf","mtime":"1374426886","size":"135837567","md5":"ea013a446c53bbb096397cc59842e18f","crc32":"5b95274d","sha1":"cc25921c5d8a01121af8acea8b14afcc2e909d73","filecount":"178"},{"name":"central-boston-1892-hathi-mdp-39015063770823-png_page_numbers.json","source":"derivative","hocr_pagenumber_module_version":"1.0.5","hocr_pagenumber_hocr_version":"1.1.54","hocr_pagenumber_confidence":"0","format":"Page Numbers JSON","original":"central-boston-1892-hathi-mdp-39015063770823-png_hocr.html","mtime":"1767211390","size":"30312","md5":"c0cb2cbd4a38c30356ffec3fedefc07b","crc32":"1d783b02","sha1":"bfc252d4030f7f276f4c360cce739de1e870543d"},{"name":"central-boston-1892-hathi-mdp-39015063770823-png_scandata.xml","source":"derivative","format":"Scandata","original":"central-boston-1892-hathi-mdp-39015063770823-png_djvu.xml","mtime":"1767211390","size":"53568","md5":"220b03772bc73f448389c65de88738ba","crc32":"51b13966","sha1":"739e75140028f6bc06f2f4e13b1afa59a3048234"},{"name":"central-boston-1892-hathi-mdp-39015063770823-png_text.pdf","source":"derivative","pdf_module_version":"0.0.25","pdf_degraded":"invalid-jp2-headers","format":"Additional Text PDF","original":"central-boston-1892-hathi-mdp-39015063770823-png_page_numbers.json","mtime":"1767212661","size":"20148545","md5":"28ab73b30d0ba0f7f75c8d993718b189","crc32":"e245a893","sha1":"abf3a8d7a934d2aa03108259eed0c3f762dc301e"}],"files_count":21,"item_last_updated":1781586957,"item_size":275058119,"metadata":{"identifier":"CentralBoston1892Specimen","uploader":"dmm@lemur.com","addeddate":"2013-07-21 16:51:31","title":"Popular Designs for Artistic Printers","creator":"Central Type Foundry and Boston Type Foundry","mediatype":"texts","collection":["typecatalogs","catalogs"],"description":"This specimen was produced at a point of great change in the American typefounding industry. The owners of the Central Type Foundry (Schraubstadter and St. John) had purchased the Boston Type Foundry in 1888. This specimen book, a joint effort of the two type foundries, is dated 1892. That is the year in which both companies were sold into the newly formed American Type Founders amalgamation. The bulk of the specimen book itself makes no reference to ATF. However, a final page (which is typographically distinct from the rest) advertises \"Original Type Designs\" for sale by many of the type foundries which amalgamated into ATF (two of which are noted as \"Owned and Operated by the American Type Founders' Company\"). On its title page this specimen refers only to the Central and the Boston foundries, but the cover of this particular copy bears the title \"Artistic Novelties for Printers, for sale by Boston Type Foundry, Boston.\" It seems reasonable to conclude that this specimen was prepared jointly by the Central and Boston foundries before the formation of ATF but that this particular copy was published by the Boston Type Foundry after the formation of ATF. Many of the larger foundries which combined into ATF retained separate identities for several years. (Annenberg, in Type Foundries of America and their Catalogs, indicates that the Central did not produce a specimen under the ATF name until 1895.) \n\nThis is a PDF assembled from the Google scans of the University of Michigan copy, as presented via The Hathi Trust (Hathi ID: mdp.39015063770823 )\n\nThis is the same digitization which formerly appeared as:\n\nhttp://archive.org/details/ATF1892CentralBostonSpecimen\n\nSince it is really a Central/Boston specimen which happens to have been printed after the incorporation of ATF, it seems better to put it here rather than there.\n\nThe page images here were scanned at multiple resolutions, and so appear in different sizes.  Although this makes viewing more difficult, I have not \"normalized\" them to a single size as that would involve the distortion of the digital information in the images.","date":"1892","year":"1892","subject":"type; typefounding; type specimen books","licenseurl":"http://creativecommons.org/publicdomain/mark/1.0/","notes":"I have set the \"publisher\" field in the metadata for this work to \"digital reprint by www.CircuitousRoot.com\" so as to link it with other works I have uploaded. However, the credit for digitizing it and making this digitization available must go to the University of Michigan, the Hathi Trust, and Google.","rights":"Public domain due to the expiration of all possibly copyright.","contributor":"Dr. David M. MacMillan","publisher":"digital reprint by www.CircuitousRoot.com","language":"EN","coverage":"USA","identifier-access":"http://archive.org/details/CentralBoston1892Specimen","identifier-ark":"ark:/13960/t2k665s7q","ppi":"300","repub_state":"4","publicdate":"2013-07-21 20:00:49","curation":"[curator]malware@archive.org[/curator][date]20140321083327[/date][comment]checked for malware[/comment]","backup_location":"ia905703_33","ocr_module_version":"0.0.21","ocr_converted":"abbyy-to-hocr 1.1.37","page_number_confidence":"0","page_number_module_version":"1.0.5","pdf_degraded":"invalid-jp2-headers","pdf_module_version":"0.0.25"},"server":"ia803207.us.archive.org","uniq":958390176,"workable_servers":["ia803207.us.archive.org","ia903207.us.archive.org"]}